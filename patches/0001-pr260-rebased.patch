+#pragma unroll
+    for (int jj = 0; jj < 8; ++jj) {
+#pragma unroll
+        for (int j = 0; j < 8; ++j) if (!(j & 2)) BF(v[j][jj], v[j | 2][jj]);        // c5
+#pragma unroll
+        for (int j = 0; j < 4; ++j) BF(v[j][jj], v[j | 4][jj]);                      // c6
+#pragma unroll
+        for (int m = 4; m <= 16; m <<= 1)                                            // c0, c1, c2
+#pragma unroll
